type string(bytes: [u8; _])
{
    _bytes : [u8; _] : bytes

    def length() i32
    {
        return ._bytes.length;
    }

    def isEmpty() bool
    {
        return ._bytes.length == 0;
    }

    def byteAt(index: i32) u8
    {
        return ._bytes.at(index);
    }

    def equals(other: string) bool
    {
        if ._bytes.length != other._bytes.length
        {
            return false;
        }

        i := 0;
        while i < ._bytes.length
        {
            if ._bytes.at(i) != other._bytes.at(i)
            {
                return false;
            }
            i = i %+ 1;
        }
        return true;
    }

    def notEquals(other: string) bool
    {
        return !.equals(other);
    }
}
