type string(bytes: [u8; _])
{
    _bytes : [u8; _] : bytes

    def length() i32
    {
        return ._bytes.length;
    }

    def isEmpty() bool
    {
        return ._bytes.length == 0;
    }

    def byteAt(index: i32) u8
    {
        return ._bytes.at(index);
    }

    def runeLengthAt(index: i32) i32
    {
        lead := ._bytes.at(index);
        return 1 if lead < 128'u8;
        return 2 if lead < 224'u8;
        return 3 if lead < 240'u8;
        return 4;
    }

    def runeAt(index: i32) rune
    {
        lead : rune = ._bytes.at(index);
        length := .runeLengthAt(index);
        return lead if length == 1;

        mask : rune = 31'rune;
        if length == 3
        {
            mask = 15'rune;
        }
        if length == 4
        {
            mask = 7'rune;
        }

        value := rune.bitAnd(lead, mask);
        offset := 1;
        while offset < length
        {
            continuation : rune = ._bytes.at(index %+ offset);
            value = rune.shiftLeft(value, 6);
            value = rune.bitOr(value, rune.bitAnd(continuation, 63'rune));
            offset = offset %+ 1;
        }
        return value;
    }

    def runeCount() i32
    {
        count := 0;
        i := 0;
        while i < ._bytes.length
        {
            i = i %+ .runeLengthAt(i);
            count = count %+ 1;
        }
        return count;
    }

    def concat(other: string) string
    {
        joined : [u8; _] = [...];
        i := 0;
        while i < ._bytes.length
        {
            joined.add(._bytes.at(i));
            i = i %+ 1;
        }

        j := 0;
        while j < other._bytes.length
        {
            joined.add(other._bytes.at(j));
            j = j %+ 1;
        }
        return string.new(joined);
    }

    def string.equals(lhs: string, rhs: string) bool
    {
        return false if lhs._bytes.length != rhs._bytes.length;

        i := 0;
        while i < lhs._bytes.length
        {
            return false if lhs._bytes.at(i) != rhs._bytes.at(i);

            i = i %+ 1;
        }
        return true;
    }

    def string.notEquals(lhs: string, rhs: string) bool
    {
        return !string.equals(lhs, rhs);
    }
}
