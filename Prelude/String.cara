type string(bytes: [u8; _])
{
    _bytes : [u8; _] : bytes

    def length() i32
    {
        return ._bytes.length;
    }

    def isEmpty() bool
    {
        return ._bytes.length == 0;
    }

    def byteAt(index: i32) u8
    {
        return ._bytes.at(index);
    }

    def concat(other: string) string
    {
        joined : [u8; _] = [...];
        i := 0;
        while i < ._bytes.length
        {
            joined.add(._bytes.at(i));
            i = i %+ 1;
        }

        j := 0;
        while j < other._bytes.length
        {
            joined.add(other._bytes.at(j));
            j = j %+ 1;
        }
        return string.new(joined);
    }

    def string.equals(lhs: string, rhs: string) bool
    {
        return false if lhs._bytes.length != rhs._bytes.length;

        i := 0;
        while i < lhs._bytes.length
        {
            return false if lhs._bytes.at(i) != rhs._bytes.at(i);

            i = i %+ 1;
        }
        return true;
    }

    def string.notEquals(lhs: string, rhs: string) bool
    {
        return !string.equals(lhs, rhs);
    }
}
