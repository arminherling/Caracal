// Caracal extern C declarations
type C
{
    // writes the message to stdout and adds a newline at the end
    #extern(symbol = "puts")
    def C.puts(message: cstring) i32 {}

    // formats the message using C-style format strings and writes to stdout
    #extern(symbol = "printf")
    def C.printf(format: cstring, ...) i32 {}

    // returns the time since program start in clock ticks
    #extern(symbol = "clock")
    def C.clock() i32 {}

    // compares two C strings, returns 0 when they are equal, non-zero otherwise
    #extern(symbol = "strcmp")
    def C.strcmp(left: cstring, right: cstring) i32 {}

    // allocates count * size bytes of zero-initialized heap memory, returns a null pointer on failure
    #extern(symbol = "calloc")
    def C.calloc(count: i64, size: i64) rawptr {}

    // resizes an allocation to size bytes, the returned pointer may differ from the given one
    #extern(symbol = "realloc")
    def C.realloc(pointer: rawptr, size: i64) rawptr {}

    // releases an allocation, the pointer must not be used afterwards
    #extern(symbol = "free")
    def C.dealloc(pointer: rawptr) {}
}
