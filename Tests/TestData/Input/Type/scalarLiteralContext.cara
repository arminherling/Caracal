type Box()
{
    v : u8 = 72

    def value() u8
    {
        return .v;
    }
}

def take(value: i64) i64
{
    return value;
}

def main() i32
{
    x : u8 = 72;
    y : u8 = 0;
    y = 101;
    b := Box.new();
    if x != 72'u8
    {
        return 2;
    }
    if y != 101'u8
    {
        return 3;
    }
    if b.value() != 72'u8
    {
        return 4;
    }
    if take(9) != 9'i64
    {
        return 5;
    }
    return 42;
}
