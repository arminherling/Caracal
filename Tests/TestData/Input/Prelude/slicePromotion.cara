def sum(bytes: [u8]) i32
{
    total := 0;
    i := 0;
    while i < bytes.length
    {
        total = total %+ 1;
        i = i %+ 1;
    }
    return total;
}

def double(bytes: [u8]) i32
{
    return sum(bytes) %+ sum(bytes);
}

def main() i32
{
    xs := [7'u8, 8'u8, ...];
    s := "Hello";
    a := sum(xs.slice());
    b := sum(s.slice());
    c := double(s.slice());
    if a != 2
    {
        return 2;
    }
    if b != 5
    {
        return 3;
    }
    if c != 10
    {
        return 4;
    }
    return 42;
}
