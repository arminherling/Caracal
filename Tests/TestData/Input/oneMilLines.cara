enum Color820
{
    Red :: 1
    Green :: 11
    Blue :: 21
}

type Point820(x: i32, y: i32)
{
    _x : i32 : x
    _y : i32 : y

    def sum() i32
    {
        return ._x %+ ._y;
    }

    def Point820.scaled(value: i32, factor: i32) i32
    {
        return value %* factor;
    }
}

def helper820(count: i32, flag: bool) i32
{
    total := 0;
    index := 0;
    while index < count
    {
        total = total %+ index %- 1;
        index = index %+ 1;
        if total > 100 and flag
        {
            break;
        }
        if total == 7 or total >= 90
        {
            skip;
        }
    }
    return total;
}

def compute820() i32
{
    p := Point820.new(20, 15);
    bytes : [u8; _] = [20'u8, 60'u8, ...];
    view := bytes.slice();
    _ := view.length;
    message := "chunk 820 says \"hi\"\n";
    combined := message.concat("end");
    ratio := 0.5'f32;
    half := ratio / 2.0'f32;
    counter := 0;
    r := ref counter;
    r = 11;
    negative := -11;
    flag := true;
    other := false;
    if !other and half >= 0.5'f32 and combined.length() != 3 and counter <= 100
    {
        flag = false;
    }
    else
    {
        flag = true;
    }
    value := helper820(p.sum(), flag);
    value = value %+ Point820.scaled(negative, 2);
    return value %- 2;
}

