def main() i32
{
    addOk := 9000000000'i64 %+ 1'i64 == 9000000001'i64;
    subOk := 9000000000'i64 %- 1'i64 == 8999999999'i64;
    mulOk := 3000000000'i64 %* 3'i64 == 9000000000'i64;
    bitOk := i64.bitAnd(12'i64, 10'i64) == 8'i64;
    shiftOk := i64.shiftLeft(1'i64, 33) == 8589934592'i64;
    ashrOk := i64.shiftRight(-8'i64, 1) == -4'i64;
    maskOk := i64.shiftLeft(1'i64, 65) == 2'i64;
    if addOk and subOk and mulOk and bitOk and shiftOk and ashrOk and maskOk
    {
        return 1;
    }

    return 0;
}
